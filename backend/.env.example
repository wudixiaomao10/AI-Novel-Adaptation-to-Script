# mock keeps the app fully local. Use openai, openai_compatible, deepseek, or qwen for real LLMs.
NOVEL2SCRIPT_LLM_PROVIDER=mock

# Required only when provider is not mock.
NOVEL2SCRIPT_LLM_API_KEY=

# Optional. Defaults are selected automatically for openai/deepseek/qwen.
# NOVEL2SCRIPT_LLM_BASE_URL=https://api.openai.com/v1
# NOVEL2SCRIPT_LLM_MODEL=gpt-4o-mini

NOVEL2SCRIPT_LLM_TIMEOUT=45
NOVEL2SCRIPT_LLM_TEMPERATURE=0.3
NOVEL2SCRIPT_LLM_MAX_RETRIES=2
NOVEL2SCRIPT_LLM_JSON_MODE=true

# Keep false unless your network requires an HTTP proxy.
NOVEL2SCRIPT_LLM_USE_PROXY=false
